{
  "name": "totvibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/openai-compatible": "^2",
      "@happy-dom/global-registrator": "^20",
      "@opentui/core": "latest",
      "@opentui/react": "latest",
      "@testing-library/react": "^16",
      "@totvibe/eslint-config": "^0.2.0",
      "@types/bun": "latest",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "ai": "^6",
      "citty": "^0.2.2",
      "eslint": "^10.4.1",
      "jiti": "^2.7.0",
      "jotai": "^2",
      "knip": "^6.16.1",
      "npm-check-updates": "^22.2.3",
      "prettier": "^3.8.3",
      "react": "^19",
      "react-dom": "^19",
      "typescript": "^6.0.3",
      "zod": "^4"
    }
  },
  "scripts": {
    "start": "bun run apps/tui/src/index.tsx",
    "serve": "bun run apps/tui/src/index.tsx --serve",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "knip": "knip-bun",
    "test": "bun run test:tui && bun run test:web",
    "test:tui": "bun test packages/tests/src/tui packages/tests/src/wire.test.ts",
    "test:web": "bun test --preload ./packages/tests/src/web/happydom.ts packages/tests/src/web",
    "build:sandbox": "bash scripts/build-sandbox.sh",
    "upgrade": "npm-check-updates --root --workspaces --format group"
  },
  "devDependencies": {
    "npm-check-updates": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@totvibe/eslint-config": "catalog:",
    "@totvibe/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "react": "catalog:"
  }
}
