{
  "name": "totvibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run apps/tui/src/index.tsx",
    "serve": "bun run apps/tui/src/index.tsx --serve",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "knip": "knip-bun",
    "test": "bun run test:tui && bun run test:web",
    "test:tui": "bun test packages/tests/src/tui packages/tests/src/wire.test.ts",
    "test:web": "bun test --preload ./packages/tests/src/web/happydom.ts packages/tests/src/web",
    "build:sandbox": "bash scripts/build-sandbox.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@totvibe/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19",
    "eslint": "^10.4.1",
    "jiti": "^2.7.0",
    "knip": "^6.15.0",
    "react": "^19",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0"
  }
}
