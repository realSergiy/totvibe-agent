# Provider (all OpenAI-compatible):
#   qwen | glm | glm-cn | kimi | mimo | deepseek | gemini | minimax | mistral   (see README)
#   glm = Z.ai GLM Coding Plan (Global); glm-cn = Zhipu GLM Coding Plan (China)
AI_PROVIDER=qwen

# Model id for the selected provider (optional; sensible default per provider)
# MODEL=qwen3.7-max

# API key for the selected provider — set the one that matches AI_PROVIDER
DASHSCOPE_API_KEY=    # qwen
# ZAI_API_KEY=          # glm    (Z.ai GLM Coding Plan, Global)
# ZHIPU_API_KEY=        # glm-cn (Zhipu GLM Coding Plan, China)
# MOONSHOT_API_KEY=     # kimi
# MIMO_API_KEY=         # mimo
# DEEPSEEK_API_KEY=     # deepseek
# GEMINI_API_KEY=       # gemini
# MINIMAX_API_KEY=      # minimax
# MISTRAL_API_KEY=      # mistral

# Set to 1 for Auto mode: auto-approve mutating tools (write_file / run_bash) for
# unattended runs. The absolute-deny list (rm -rf /, force-push, pipe-to-shell,
# credential paths, …) is still enforced and cannot be crossed in Auto mode.
# AUTO_APPROVE=1

# Sandbox (Linux): network is isolated by default; set inherit to allow network in run_bash
# TOTVIBE_SANDBOX_NET=inherit
# Override the sandbox helper binary path (defaults to packages/sandbox/bin/totvibe-sandbox)
# TOTVIBE_SANDBOX_BIN=

# Agent-loop limits (the loop enforces these; the model cannot override them)
# TOTVIBE_MAX_STEPS=24
# TOTVIBE_WALL_CLOCK_MS=600000
# TOTVIBE_TOKEN_BUDGET=             # defaults to the model's context window × 8
# TOTVIBE_APPROVAL_TIMEOUT_MS=0     # 0 = wait indefinitely for an approval keypress

# Where sessions and the approval/audit ledger are stored (default ~/.totvibe)
# TOTVIBE_DATA_DIR=
