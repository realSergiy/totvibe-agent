# Provider: anthropic (default), openai, or an OpenAI-compatible provider:
#   qwen | glm | kimi | mimo | deepseek   (see README)
AI_PROVIDER=anthropic

# Model id for the selected provider (optional; sensible default per provider)
# MODEL=claude-opus-4-7

# API key for the selected provider — set the one that matches AI_PROVIDER
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=    # qwen
# ZAI_API_KEY=          # glm
# MOONSHOT_API_KEY=     # kimi
# MIMO_API_KEY=         # mimo
# DEEPSEEK_API_KEY=     # deepseek

# Set to 1 to skip approval prompts for write_file / run_bash (unattended runs)
# AUTO_APPROVE=1

# Sandbox (Linux): network is isolated by default; set inherit to allow network in run_bash
# TOTVIBE_SANDBOX_NET=inherit
# Override the sandbox helper binary path (defaults to packages/sandbox/bin/totvibe-sandbox)
# TOTVIBE_SANDBOX_BIN=
